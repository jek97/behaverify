configuration {}
enumerations {}
constants {MIN_X := 0, MAX_X := 24, MIN_Y := 0, MAX_Y := 15, GRID_HEIGHT := 16, MOVING_DRAIN := 5}
variables {
variable { bl x VAR [MIN_X, MAX_X] assign{result{2}}}
variable { bl y VAR [MIN_Y, MAX_Y] assign{result{2}}}
variable { bl prev_x VAR [MIN_X, MAX_X] assign{result{2}}}
variable { bl prev_y VAR [MIN_Y, MAX_Y] assign{result{2}}}
variable { bl target_x VAR [MIN_X, MAX_X] assign{result{2}}}
variable { bl target_y VAR [MIN_Y, MAX_Y] assign{result{2}}}
variable { bl battery VAR [0, 100] assign{result{100}}}
variable { env noise_x VAR {-1, 0, 1} assign{result{0}}}
variable { env noise_y VAR {-1, 0, 1} assign{result{0}}}
variable { env battery_noise VAR {-1, 0, 1} assign{result{0}}}
}
environment_update {
variable_statement { noise_x assign{result{(loop, __i, {-1, 0, 1} such_that True, __i)}}}
variable_statement { noise_y assign{result{(loop, __i, {-1, 0, 1} such_that True, __i)}}}
variable_statement { battery_noise assign{result{(loop, __i, {-1, 0, 1} such_that True, __i)}}}
}
checks {
check { BatteryOver_70
    arguments {} read_variables {battery}
    condition {(gt, battery, 70)}
}
}
environment_checks {}
actions {
action { PlanStraight_22_2
    arguments {} local_variables {} read_variables {} write_variables {target_x, target_y}
    initial_values {}
    update {
        variable_statement {target_x assign{result{22}}}
        variable_statement {target_y assign{result{2}}}
        return_statement {
            result {success}
        }
    }
}
action { MoveTo
    arguments {} local_variables {} read_variables {x, y, target_x, target_y, battery, noise_x, noise_y, battery_noise} write_variables {x, y, prev_x, prev_y, battery}
    initial_values {}
    update {
        variable_statement {prev_x assign{result{x}}}
        variable_statement {prev_y assign{result{y}}}
        read_environment {apply_noise
            condition {True}
            variable_statement {x assign{result{(max, MIN_X, (min, MAX_X, (add, x, (max, -1, (min, 1, (add, (if, (gt, target_x, x), 1, (if, (lt, target_x, x), -1, 0)), noise_x))))))}}}
            variable_statement {y assign{result{(max, MIN_Y, (min, MAX_Y, (add, y, (max, -1, (min, 1, (add, (if, (gt, target_y, y), 1, (if, (lt, target_y, y), -1, 0)), noise_y))))))}}}
            variable_statement {battery assign{result{(max, 0, (sub, battery, (add, MOVING_DRAIN, battery_noise)))}}}
        }
        return_statement {
            case {(and, (eq, x, target_x), (eq, y, target_y))} result {success}
            case {(lte, battery, 0)} result {failure}
            result {running}
        }
    }
}
action { PlanStraight_2_2
    arguments {} local_variables {} read_variables {} write_variables {target_x, target_y}
    initial_values {}
    update {
        variable_statement {target_x assign{result{2}}}
        variable_statement {target_y assign{result{2}}}
        return_statement {
            result {success}
        }
    }
}
}
sub_trees {}
tree {
    composite {BatteryFallback
        selector with_partial_memory
        children {
            composite {TryGoal
                sequence
                children {
                    BatteryFallback_TryGoal_BatteryOver: BatteryOver_70 {}

                    BatteryFallback_TryGoal_PlanStraight: PlanStraight_22_2 {}

                    BatteryFallback_TryGoal_MoveTo: MoveTo {}

                }
            }

            composite {GoHome
                sequence with_partial_memory
                children {
                    BatteryFallback_GoHome_PlanStraight: PlanStraight_2_2 {}

                    BatteryFallback_GoHome_MoveTo: MoveTo {}

                }
            }

        }
    }
}
tick_prerequisite {True}
specifications {
    LTLSPEC {(finally, (and, (eq, x, 22), (eq, y, 2)))}
}
